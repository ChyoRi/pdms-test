rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 로그인 + 승인된 사용자인지
    function isApproved() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('approved', false) == true;
    }
    // 관리자(가입 승인 권한)
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('can_switch_account', false) == true;
    }

    // 회원가입 화면 공개 정보
    match /company_signup_info/{companyId} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{userId} {
      // 본인 문서, 또는 승인된 사용자면 다른 사람도 조회 가능(리스트 표시용), 관리자도 가능
      allow read: if request.auth != null &&
        (request.auth.uid == userId || isApproved() || isAdmin());

      // 가입: 본인 uid + company_signup_info 값 일치 + approved=false + can_switch_account 자가부여 금지
      allow create: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.data.companyKey is string &&
        exists(/databases/$(database)/documents/company_signup_info/$(request.resource.data.companyKey)) &&
        get(/databases/$(database)/documents/company_signup_info/$(request.resource.data.companyKey)).data.signup_active == true &&
        request.resource.data.company ==
          get(/databases/$(database)/documents/company_signup_info/$(request.resource.data.companyKey)).data.company_name &&
        request.resource.data.role ==
          get(/databases/$(database)/documents/company_signup_info/$(request.resource.data.companyKey)).data.role &&
        request.resource.data.get('approved', false) == false &&
        request.resource.data.get('can_switch_account', false) == false;

      // 본인 수정: approved / can_switch_account / company / companyKey / role 변경 금지
      // (단, can_switch_account:true 계정은 SwitchRole로 company/role 변경 허용)
      allow update: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.get('approved', false) == resource.data.get('approved', false) &&
        request.resource.data.get('can_switch_account', false) == resource.data.get('can_switch_account', false) &&
        (
          (
            request.resource.data.company == resource.data.company &&
            request.resource.data.companyKey == resource.data.companyKey &&
            request.resource.data.role == resource.data.role
          )
          || resource.data.get('can_switch_account', false) == true
        );

      // 관리자: 남의 문서 승인 처리(approved 변경) 및 삭제(거절) 가능
      allow update: if isAdmin();
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == userId);
    }

    match /design_request/{requestId} {
      allow read: if isApproved();
      allow write: if isApproved();

      match /comments/{commentId} {
        allow read: if isApproved();
        allow write: if isApproved();
      }
    }

    match /companies/{companyId} {
      allow read, write: if isApproved();
    }
  }
}
