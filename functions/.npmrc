# Cloud Build 배포용 설정.
#
# pnpm 10+ 는 의존성의 postinstall 을 기본적으로 실행하지 않고,
# Cloud Build 는 그것을 ERR_PNPM_IGNORED_BUILDS 에러로 처리해 배포가 실패한다.
# (firebase-admin 이 끌고 오는 @firebase/util, protobufjs 가 여기 걸린다)
#
# onlyBuiltDependencies 는 package.json / pnpm-workspace.yaml 에 둬 봤으나
# Cloud Build 의 pnpm 이 읽지 않았다. .npmrc 는 읽는다.
# 결과적으로 npm 의 기본 동작과 같아진다.
dangerously-allow-all-builds=true
